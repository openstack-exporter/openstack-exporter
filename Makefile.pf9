# Platform9 container build for openstack-exporter.
#
# Kept separate from the upstream Makefile so rebases against
# openstack-exporter/openstack-exporter stay conflict-free.
#
#   make -f Makefile.pf9 all
#
# TeamCity supplies PF9_VERSION and BUILD_NUMBER; the defaults below are only
# for local runs.

APP_NAME ?= openstack-exporter
DOCKER ?= docker

GOOS ?= linux
GOARCH ?= amd64
CGO_ENABLED ?= 0
GO_VERSION ?= 1.24

PF9_VERSION ?= 1.0.0
BUILD_NUMBER ?= 0
BRANCH ?= $(or $(TEAMCITY_BUILD_BRANCH),$(shell git symbolic-ref --short HEAD 2>/dev/null || echo local))
APP_METADATA ?=

IMAGE_NAME ?= quay.io/platform9/$(APP_NAME)
ECR_IMAGE_NAME ?= public.ecr.aws/platform9/$(APP_NAME)
IMAGE_TAG ?= $(PF9_VERSION)-$(BUILD_NUMBER)
FULL_IMAGE ?= $(IMAGE_NAME):$(IMAGE_TAG)
ECR_FULL_IMAGE ?= $(ECR_IMAGE_NAME):$(IMAGE_TAG)

DOCKERFILE ?= Dockerfile.pf9

.PHONY: all build push print clean

all: build push print

build:
	@echo "Building Docker image: $(FULL_IMAGE)"
	$(DOCKER) build \
		--build-arg GO_VERSION=$(GO_VERSION) \
		--build-arg GOOS=$(GOOS) \
		--build-arg GOARCH=$(GOARCH) \
		--build-arg CGO_ENABLED=$(CGO_ENABLED) \
		--build-arg VERSION=$(PF9_VERSION) \
		--build-arg BUILD_ID=$(BUILD_NUMBER) \
		--build-arg BRANCH=$(BRANCH) \
		--build-arg APP_METADATA=$(APP_METADATA) \
		-f $(DOCKERFILE) -t $(FULL_IMAGE) .
	$(DOCKER) tag $(FULL_IMAGE) $(ECR_FULL_IMAGE)
	echo $(IMAGE_TAG) > container-tag

push:
	@echo "Pushing Docker image: $(FULL_IMAGE) and $(ECR_FULL_IMAGE)"
	$(DOCKER) push $(FULL_IMAGE)
	$(DOCKER) push $(ECR_FULL_IMAGE)

print:
	@echo "GOOS=$(GOOS)"
	@echo "GOARCH=$(GOARCH)"
	@echo "CGO_ENABLED=$(CGO_ENABLED)"
	@echo "PF9_VERSION=$(PF9_VERSION)"
	@echo "BUILD_NUMBER=$(BUILD_NUMBER)"
	@echo "BRANCH=$(BRANCH)"
	@echo "FULL_IMAGE=$(FULL_IMAGE)"
	@echo "ECR_FULL_IMAGE=$(ECR_FULL_IMAGE)"

clean:
	rm -f container-tag
	-$(DOCKER) rmi $(FULL_IMAGE) $(ECR_FULL_IMAGE) 2>/dev/null || true
